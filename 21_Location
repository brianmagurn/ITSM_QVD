    SCHOOL_CODE,
    S_TYPE,
    SCH_DESC,
    CLUSTER_CODE,
    Latitude,
    Longitude,
    LatitudeLongitude,
    WEBSITE_URL
FROM [lib://DATA - Public (DW):SharedConnectToQvdPUB/SIS_SCHOOL.qvd]
