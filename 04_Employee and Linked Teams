[LinkedTeams]:
LOAD Employee_PK, 
	 Team_PK
;

SELECT Employee.DisplayName, Employee.LoginID, Employee.RecId as Employee_PK,  StandardUserTeam.RecId as Team_PK, StandardUserTeam.Team
FROM FusionLink
	INNER JOIN StandardUserTeam ON FusionLink.sourceID = StandardUserTeam.RecId
	Inner join Employee ON FusionLink.targetID = Employee.RecId and targetbase = 'Employee' and SourceBase = 'StandardUserTeam'

	WHERE FusionLink.RelationshipName = 'ProfileEmployeeAssociatedByStandardUserTeam'
;

Join (Employee)
LOAD Employee_PK, 
	 COUNT(Team_PK) As 'Linked Teams'
          Resident LinkedTeams
          Group By Employee_PK;
    
 
 
 
 
  
